DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Envoi des emails "Mot de passe oublié" (exemple Gmail : utiliser un mot de passe d'application)
# Sans EMAIL_HOST_USER, les emails s'affichent dans le terminal Django.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
FRONTEND_URL=http://localhost:3000
